{
  "name": "kaneapp",
  "productName": "KaneApp",
  "version": "1.41.0",
  "description": "KaneApp — éditeur d'images, Studio IA, Vidéo IA et Montage",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never",
    "release": "electron-builder --win --x64 --publish always"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "ag-psd": "^31.0.3",
    "electron-updater": "^6.8.9",
    "onnxruntime-node": "^1.30.0"
  },
  "author": "Kane",
  "homepage": "https://github.com/Kaynegiordano/KaneApp",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kaynegiordano/KaneApp.git"
  },
  "license": "UNLICENSED",
  "build": {
    "appId": "com.kane.kanevas",
    "productName": "KaneApp",
    "executableName": "KaneApp",
    "copyright": "Kane",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "onnx-sessions.cjs",
      "gpu-memory.cjs",
      "output-paths.cjs",
      "preload.js",
      "updater.cjs",
      "recovery-store.cjs",
      "translate.cjs",
      "services.cjs",
      "local-process.cjs",
      "studio-runtime.cjs",
      "managed-runtimes.cjs",
      "runtime-migration-host.cjs",
      "runtime-migrate.py",
      "suite-store.cjs",
      "suite-host.cjs",
      "suite-bridges.cjs",
      "kaneclip-host.cjs",
      "kaneclip/**/*",
      "!kaneclip/tests/**",
      "app/**/*",
      "!app/**/*.map",
      "!node_modules/onnxruntime-node/bin/napi-v6/{darwin,linux}/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"
    ],
    "extraResources": [
      {
        "from": "app/kanevas.ico",
        "to": "kanevas-app.ico"
      }
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "runtime-migrate.py"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "KaneApp-Setup-${version}.${ext}",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KaneApp",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "language": "1036",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Kaynegiordano",
        "repo": "KaneApp",
        "releaseType": "release"
      }
    ]
  }
}
